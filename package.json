{
  "name": "ecommerce-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "infra": "docker compose up -d mongodb redis rabbitmq",
    "infra:stop": "docker compose stop",
    "dev": "concurrently -n \"INFRA,GATEWAY,AUTH,CATALOG,INVENTORY,CART,ORDER,NOTIFY\" -c \"gray,magenta,blue,green,yellow,cyan,red,white\" \"pnpm infra\" \"pnpm --filter api-gateway dev\" \"pnpm --filter auth-service dev\" \"pnpm --filter catalog-service dev\" \"pnpm --filter inventory-service dev\" \"pnpm --filter cart-service dev\" \"pnpm --filter order-service dev\" \"pnpm --filter notification-service dev\"",
    "dev:gateway": "pnpm --filter api-gateway dev",
    "dev:auth": "pnpm --filter auth-service dev",
    "dev:catalog": "pnpm --filter catalog-service dev",
    "dev:cart": "pnpm --filter cart-service dev",
    "dev:order": "pnpm --filter order-service dev",
    "dev:payment": "pnpm --filter payment-service dev",
    "dev:inventory": "pnpm --filter inventory-service dev",
    "dev:notification": "pnpm --filter notification-service dev",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,yml,yaml}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v",
    "docker:build": "docker compose build --parallel",
    "docker:logs": "docker compose logs -f",
    "clean": "turbo run clean && rimraf node_modules",
    "build:common": "pnpm --filter @ecommerce/common build"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "concurrently": "^8.2.0",
    "eslint": "^8.55.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.1.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.8.9"
  }
}
