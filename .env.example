# ═══════════════════════════════════════════
# Root Environment Variables
# Copy to .env and fill in real values
# ═══════════════════════════════════════════
NODE_ENV=development

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your_secure_password_here

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=your_secure_password_here
RABBITMQ_VHOST=/

# Grafana
GRAFANA_USER=admin
GRAFANA_PASS=your_secure_password_here

# Service Ports
GATEWAY_PORT=3000
AUTH_PORT=3001
CATALOG_PORT=3002
CART_PORT=3003
ORDER_PORT=3004
PAYMENT_PORT=3005
INVENTORY_PORT=3006
NOTIFICATION_PORT=3007
