{
  "name": "@ecommerce/common",
  "version": "1.0.0",
  "description": "Shared utilities and infrastructure for microservices",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,json}\"",
    "clean": "rimraf dist coverage .turbo",
    "build": "echo 'No build step needed - ES modules'"
  },
  "keywords": [
    "microservices",
    "shared",
    "common",
    "utilities",
    "infrastructure"
  ],
  "author": "Your Team",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-prometheus": "^0.45.1",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "amqplib": "^0.10.3",
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.2.0",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "sinon": "^17.0.1",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "express": "^4.18.2",
    "mongoose": "^9.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
