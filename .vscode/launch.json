    },
    {
      "name": "Debug Current Test File",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "args": ["vitest", "run", "${relativeFile}", "--reporter=verbose"],
      "console": "integratedTerminal"
    }
  ]
}
